# ==============================================================================
# Telegram API Credentials (https://my.telegram.org)
# ==============================================================================
TG_APP_ID=1234567
TG_APP_HASH=0123456789abcdef0123456789abcdef
# (Also accepts API_ID and API_HASH)

# ==============================================================================
# Telegram Bot Authentication (@BotFather)
# ==============================================================================
TG_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Optional phone number for user session auth (if not using bot token)
TG_PHONE=

# Session file storage path (stored inside the persistent Docker volume ./data)
TG_SESSION_FILE=/app/data/tg_session.json

# ==============================================================================
# Telegram Destination
# ==============================================================================
# - "self" for Saved Messages (Избранное)
# - "@channel_username" for public channel
# - "-100xxxxxxxxxx" for private channel (Bot must be added as Administrator!)
TG_PEER=@my_storage_channel

# ==============================================================================
# Storage & Chunking Settings
# ==============================================================================
# Size of each chunk uploaded to Telegram in Megabytes.
# Telegram Bot API max file size is 2000 MB (2 GB).
# 500 MB is ideal for VPS with 1-2 GB free disk space (single chunk FIFO buffer).
CHUNK_SIZE_MB=500

# Directory for temporary downloading of chunks (deleted immediately after upload)
TEMP_DIR=/tmp/tg_file_proxy

# ==============================================================================
# Inbound Download Engine (Origin -> VPS)
# ==============================================================================
# Number of concurrent download streams per chunk (aria2-style segmentation).
# Increases speed 5-10x on throttled CDNs/file hosts.
# Recommended: 8-16. Range: 1 to 32.
CONCURRENT_DOWNLOAD_STREAMS=8

# Timeout for remote download per chunk (in minutes)
DOWNLOAD_TIMEOUT_MINUTES=45

# Maximum retry attempts per failed segment
DOWNLOAD_MAX_RETRIES=3

# HTTP User-Agent sent to download source
DOWNLOAD_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36

# ==============================================================================
# Outbound Upload Engine (VPS -> Telegram MTProto)
# ==============================================================================
# MTProto block upload size in Kilobytes (512 is Telegram MTProto maximum and fastest)
TG_UPLOAD_PART_SIZE_KB=512

# Number of parallel upload threads to Telegram MTProto
TG_UPLOAD_THREADS=4

# ==============================================================================
# Server & Network Settings
# ==============================================================================
# Port inside the container
HTTP_PORT=8080

# Port on the VPS host exposed by docker-compose
HOST_PORT=8088
