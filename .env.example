# Telegram API Credentials (get from https://my.telegram.org)
TG_APP_ID=1234567
TG_APP_HASH=0123456789abcdef0123456789abcdef

# Telegram Bot Token (from @BotFather) or leave empty if using user session
TG_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Destination peer:
# - "self" for Saved Messages (Избранное)
# - "@your_channel_username" for a private or public channel
TG_PEER=@my_storage_channel

# Chunk size in Megabytes (500 is optimal for low disk VPS)
CHUNK_SIZE_MB=500

# Number of concurrent download streams per chunk (aria2-style multi-connection, 8-16 is ideal)
CONCURRENT_DOWNLOAD_STREAMS=8

# Server HTTP Port
HTTP_PORT=8080

